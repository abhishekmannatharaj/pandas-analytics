# --- Datasets & Data Folder ---
# Ignore everything inside data/raw and data/processed, but keep the folders via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Catch standalone dataset files placed outside data/
*.csv
*.xlsx
*.xls
*.tsv
*.parquet
*.h5
*.feather
*.zip
*.tar.gz

